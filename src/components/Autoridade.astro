---
import { AUTORIDADE, DOCTOR } from '../config/content';
---

<section class="section autoridade" id="sobre" aria-labelledby="autoridade-title">
  <div class="container autoridade__grid">
    <div class="autoridade__media" data-reveal>
      <picture>
        <source
          type="image/avif"
          srcset="/images/autoridade-480.avif 480w, /images/autoridade-800.avif 800w, /images/autoridade-1200.avif 1200w"
          sizes="(min-width: 900px) 38vw, 92vw"
        />
        <img
          src="/images/autoridade-800.webp"
          srcset="/images/autoridade-480.webp 480w, /images/autoridade-800.webp 800w, /images/autoridade-1200.webp 1200w"
          sizes="(min-width: 900px) 38vw, 92vw"
          width="800"
          height="1067"
          alt={AUTORIDADE.imageAlt}
          loading="lazy"
          decoding="async"
        />
      </picture>
    </div>

    <div class="autoridade__content">
      <div class="section-head" data-reveal>
        <span class="kicker">{AUTORIDADE.kicker}</span>
        <h2 id="autoridade-title">{AUTORIDADE.title}</h2>
      </div>
      <div data-reveal>
        {AUTORIDADE.body.map((paragraph) => <p class="body-text">{paragraph}</p>)}
        <p class="autoridade__strong">{AUTORIDADE.bodyStrong}</p>
        <span class="badge-gold">{DOCTOR.crm}</span>
      </div>
    </div>
  </div>
</section>

<style>
  .autoridade__grid {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: 64px;
    align-items: center;
  }

  .autoridade__media picture,
  .autoridade__media img {
    width: 100%;
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-soft);
  }

  .autoridade__content .section-head {
    margin-bottom: 24px;
  }

  .autoridade__content p {
    margin: 0 0 18px;
  }

  .autoridade__strong {
    font-family: var(--font-display);
    font-size: clamp(22px, 4vw, 28px);
    line-height: 1.3;
    color: var(--navy-ink);
    font-weight: var(--fw-medium);
    margin: 6px 0 26px !important;
  }

  @media (max-width: 899px) {
    .autoridade__grid {
      grid-template-columns: 1fr;
      gap: 36px;
    }

    .autoridade__media {
      max-width: 400px;
      margin: 0 auto;
    }
  }
</style>
