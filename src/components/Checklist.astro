---
import { CHECKLIST } from '../config/content';
import WhatsAppButton from './ui/WhatsAppButton.astro';
---

<section class="section checklist" id="sinais" aria-labelledby="checklist-title">
  <div class="container">
    <div class="section-head" data-reveal>
      <span class="kicker">{CHECKLIST.kicker}</span>
      <h2 id="checklist-title">{CHECKLIST.title}</h2>
    </div>

    <ul class="checklist__list" data-reveal-stagger>
      {CHECKLIST.items.map((item) => (
        <li class="checklist__item" data-reveal>
          <span class="checklist__check" aria-hidden="true">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12l5 5L20 6"/></svg>
          </span>
          <span>{item}</span>
        </li>
      ))}
    </ul>

    <div class="checklist__closing" data-reveal>
      <p class="subtitle">{CHECKLIST.closing}</p>
      <WhatsAppButton source="checklist" label={CHECKLIST.cta} variant="primary" large withIcon={false} />
    </div>
  </div>
</section>

<style>
  .checklist {
    background: var(--navy-50);
  }

  .checklist__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 14px;
    max-width: 720px;
  }

  .checklist__item {
    display: flex;
    gap: 16px;
    align-items: flex-start;
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    padding: 20px 24px;
    font-size: 16.5px;
    line-height: 1.55;
    color: var(--ink);
    font-weight: var(--fw-body);
  }

  .checklist__check {
    width: 26px;
    height: 26px;
    border-radius: var(--radius-sm);
    background: var(--navy-800);
    color: var(--white);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    margin-top: 1px;
  }

  .checklist__closing {
    margin-top: 36px;
    display: flex;
    flex-direction: column;
    gap: 22px;
    align-items: flex-start;
    max-width: 720px;
  }

  .checklist__closing p {
    margin: 0;
  }
</style>
