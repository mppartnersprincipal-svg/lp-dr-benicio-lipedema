---
import { HERO, DOCTOR } from '../config/content';
import WhatsAppButton from './ui/WhatsAppButton.astro';
---

<header class="hero on-navy" id="inicio">
  <div class="container hero__grid">
    <div class="hero__content">
      <span class="kicker hero__kicker">{HERO.kicker}</span>
      <h1 class="display hero__title" data-typewriter>Não é <em>"só gordura"</em>. E não, a culpa nunca foi sua.</h1>
      <p class="hero__sub">{HERO.subheadline}</p>
      <div class="hero__cta">
        <WhatsAppButton source="hero" label={HERO.cta} variant="gold" large withIcon={false} />
      </div>
      <p class="hero__reassurance">{HERO.ctaReassurance}</p>
      <p class="hero__micro">{HERO.microcopy}</p>
    </div>

    <div class="hero__media">
      <picture>
        <source
          type="image/avif"
          srcset="/images/hero-480.avif 480w, /images/hero-800.avif 800w, /images/hero-1200.avif 1200w"
          sizes="(min-width: 900px) 40vw, 92vw"
        />
        <img
          src="/images/hero-800.webp"
          srcset="/images/hero-480.webp 480w, /images/hero-800.webp 800w, /images/hero-1200.webp 1200w"
          sizes="(min-width: 900px) 40vw, 92vw"
          width="800"
          height="1067"
          alt={HERO.imageAlt}
          fetchpriority="high"
          loading="eager"
          decoding="async"
        />
      </picture>
      <div class="hero__badge">
        <span class="hero__badge-name">{DOCTOR.shortName}</span>
        <span class="hero__badge-crm">{DOCTOR.crm}</span>
      </div>
    </div>
  </div>
</header>

<style>
  .hero {
    background: var(--gradient-hero);
    position: relative;
    overflow: hidden;
  }

  .hero__grid {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: 56px;
    align-items: center;
    padding-top: 64px;
    padding-bottom: 72px;
    min-height: 88svh;
  }

  .hero__kicker {
    display: block;
    margin-bottom: 24px;
  }

  .hero__title {
    color: var(--on-navy-strong);
  }

  .hero__title em {
    color: var(--gold);
  }

  .hero__sub {
    font-size: 18px;
    line-height: 1.7;
    color: var(--on-navy);
    font-weight: var(--fw-body);
    max-width: 560px;
    margin: 26px 0 0;
  }

  .hero__cta {
    margin-top: 34px;
  }

  .hero__reassurance {
    font-size: 13.5px;
    color: var(--on-navy);
    font-weight: var(--fw-medium);
    margin: 12px 0 0;
    line-height: 1.5;
  }

  .hero__micro {
    font-size: 14px;
    color: var(--on-navy);
    font-weight: var(--fw-body);
    margin: 18px 0 0;
    max-width: 520px;
    line-height: 1.6;
  }

  .hero__media {
    position: relative;
  }

  .hero__media picture,
  .hero__media img {
    width: 100%;
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-deep);
  }

  .hero__badge {
    position: absolute;
    left: 20px;
    bottom: 20px;
    background: rgba(255, 255, 255, 0.94);
    border-radius: var(--radius-md);
    padding: 12px 18px;
    display: flex;
    flex-direction: column;
    gap: 2px;
    box-shadow: var(--shadow-soft);
  }

  .hero__badge-name {
    font-family: var(--font-display);
    font-size: 19px;
    font-weight: var(--fw-semibold);
    color: var(--navy-ink);
    line-height: 1.2;
  }

  .hero__badge-crm {
    font-family: var(--font-body);
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
    font-weight: var(--fw-medium);
  }

  @media (max-width: 899px) {
    .hero__grid {
      grid-template-columns: 1fr;
      gap: 36px;
      padding-top: 48px;
      padding-bottom: 56px;
      min-height: 0;
    }

    .hero__media {
      max-width: 420px;
      margin: 0 auto;
    }
  }
</style>
