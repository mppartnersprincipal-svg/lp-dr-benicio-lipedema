---
import { CTA_FINAL } from '../config/content';
import WhatsAppButton from './ui/WhatsAppButton.astro';
---

<section class="section cta-final" id="agendar" aria-labelledby="cta-final-title">
  <div class="container">
    <div class="cta-final__card on-navy" data-reveal>
      <span class="kicker">{CTA_FINAL.kicker}</span>
      <h2 id="cta-final-title">{CTA_FINAL.title}</h2>
      <p class="cta-final__subtitle">{CTA_FINAL.subtitle}</p>
      <p class="cta-final__urgency">{CTA_FINAL.urgency}</p>
      <div class="cta-final__action">
        <WhatsAppButton source="cta-final" label={CTA_FINAL.cta} variant="whatsapp" large />
      </div>
      <p class="cta-final__micro">{CTA_FINAL.microcopy}</p>
    </div>
  </div>
</section>

<style>
  .cta-final__card {
    background: var(--navy-ink);
    border-radius: var(--radius-xl);
    padding: clamp(36px, 6vw, 64px);
    box-shadow: var(--shadow-deep);
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .cta-final__card .kicker {
    font-size: 11px;
    margin-bottom: 18px;
  }

  .cta-final__card h2 {
    color: var(--on-navy-strong);
    max-width: 640px;
  }

  .cta-final__subtitle {
    font-family: var(--font-display);
    font-style: italic;
    font-size: clamp(20px, 4vw, 26px);
    color: var(--gold);
    margin: 14px 0 0;
    line-height: 1.3;
  }

  .cta-final__urgency {
    font-size: 16px;
    line-height: 1.7;
    color: var(--on-navy);
    font-weight: var(--fw-body);
    max-width: 560px;
    margin: 22px 0 0;
  }

  .cta-final__action {
    margin-top: 32px;
    width: 100%;
    max-width: 420px;
  }

  .cta-final__action :global(.btn) {
    width: 100%;
  }

  .cta-final__micro {
    font-size: 13.5px;
    color: var(--on-navy);
    font-weight: var(--fw-body);
    margin: 18px 0 0;
    max-width: 480px;
    line-height: 1.6;
  }
</style>
