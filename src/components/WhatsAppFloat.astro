---
import { waLink } from '../config/content';
---

<a
  href={waLink()}
  target="_blank"
  rel="noopener"
  class="wa-float"
  data-wa
  data-source="float"
  aria-label="Falar no WhatsApp"
>
  <svg width="26" height="26" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
    <path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2 22l5.25-1.38a9.9 9.9 0 0 0 4.79 1.22h.01c5.46 0 9.91-4.45 9.91-9.91C21.96 6.45 17.5 2 12.04 2zm5.8 14.16c-.24.68-1.42 1.32-1.96 1.36-.5.05-1.14.24-3.68-.77-3.09-1.22-5.06-4.35-5.22-4.56-.15-.2-1.25-1.66-1.25-3.17 0-1.51.79-2.25 1.07-2.56.28-.31.61-.38.81-.38.2 0 .41 0 .58.01.19.01.44-.07.68.52.24.59.83 2.04.9 2.19.07.15.12.32.02.52-.1.2-.15.32-.3.5-.15.17-.31.39-.44.52-.15.15-.3.31-.13.61.17.29.76 1.25 1.63 2.03 1.12 1 2.06 1.31 2.36 1.46.29.15.46.12.63-.07.17-.2.72-.84.91-1.13.19-.29.39-.24.65-.15.27.1 1.7.8 1.99.95.29.15.49.22.56.34.07.12.07.71-.17 1.39z"></path>
  </svg>
</a>

<style>
  .wa-float {
    position: fixed;
    right: 24px;
    bottom: 24px;
    z-index: 40;
    width: 56px;
    height: 56px;
    border-radius: var(--radius-pill);
    background: var(--whatsapp);
    color: var(--white);
    display: none;
    align-items: center;
    justify-content: center;
    box-shadow: 0 12px 28px -10px rgba(37, 211, 102, 0.75);
    transition: transform var(--ease);
  }

  .wa-float:hover {
    transform: translateY(-2px);
    color: var(--white);
  }

  /* Desktop-only: no mobile o sticky CTA assume */
  @media (min-width: 900px) {
    .wa-float {
      display: flex;
    }
  }
</style>
